<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/board_header" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center_vertical"
            android:orientation="vertical" android:clickable="true" android:focusable="true"
            android:background="?android:attr/selectableItemBackground" android:contentDescription="アプリのホームを開く">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/secretary_board" android:textStyle="bold" android:textColor="@color/widget_ink"
                android:maxLines="1" android:ellipsize="end" android:textSize="15sp" />
            <TextView android:id="@+id/board_time" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/widget_ink" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/board_memo" android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:text="メモ" android:contentDescription="@string/secretary_memo"
            android:textColor="@color/widget_ink" />
        <ImageButton android:id="@+id/board_voice" android:layout_width="36dp" android:layout_height="40dp"
            android:background="@android:color/transparent" android:src="@drawable/ic_mic"
            android:tint="@color/widget_ink" android:contentDescription="@string/voice_memo" />
        <TextView android:id="@+id/board_refresh" android:layout_width="36dp" android:layout_height="40dp"
            android:gravity="center" android:text="↻" android:textSize="22sp" android:textColor="@color/widget_ink"
            android:contentDescription="ボードを更新" />
    </LinearLayout>
    <LinearLayout android:id="@+id/board_bots" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/board_tab_tasks" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="32dp" android:layout_marginEnd="2dp" android:gravity="center"
            android:background="@drawable/board_tab" android:textColor="@color/widget_ink" android:textSize="13sp"
            android:maxLines="1" android:ellipsize="end" android:text="タスク" />
        <TextView android:id="@+id/board_tab_progress" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="32dp" android:layout_marginStart="2dp" android:gravity="center"
            android:background="@drawable/board_tab" android:textColor="@color/widget_ink" android:textSize="13sp"
            android:maxLines="1" android:ellipsize="end" android:text="進捗" />
    </LinearLayout>
    <TextView android:id="@+id/board_working" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:paddingHorizontal="10dp" android:paddingVertical="5dp"
        android:background="@drawable/board_dot" android:textColor="#FFFFFF" android:textSize="12sp"
        android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    <TextView android:id="@+id/board_pending" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginVertical="4dp" android:paddingHorizontal="10dp" android:paddingVertical="5dp"
        android:background="@drawable/board_pending" android:textColor="#251603" android:textSize="12sp"
        android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/board_list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@android:color/transparent" android:dividerHeight="1dp" />
        <TextView android:id="@+id/board_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textColor="@color/widget_ink" android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
